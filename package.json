{
  "name": "panther-fx-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx scripts/test.ts",
    "test:db": "node --import tsx tests/database.test.ts",
    "push:worker": "node --env-file-if-exists=.env.local --import tsx scripts/push-worker.ts",
    "push:keys": "node --import tsx scripts/generate-push-keys.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "webhook:secret": "node --import tsx scripts/generate-webhook-secret.ts",
    "data:import": "node --env-file-if-exists=.env.local --import tsx scripts/import-provider-data.ts",
    "calendar:queue": "node --env-file-if-exists=.env.local --import tsx scripts/queue-calendar-news.ts",
    "deploy:check": "node --env-file-if-exists=.env.local --import tsx scripts/deploy-check.ts",
    "mt5:inspect": "node --import tsx scripts/inspect-mt5.ts",
    "engine:scan": "node --env-file-if-exists=.env.local --import tsx scripts/scan-mt5.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.80.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
