# No credentials are needed for the read-only demo.
# Supabase project URL and publishable key are intentionally browser-visible.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep service-role, market provider, push private keys and AI keys server-side.
# They are not used or required by Phase 1.

# Phase 2: optional server-only webhook ingestion. Use secure environment settings.
SUPABASE_SERVICE_ROLE_KEY=
TRADINGVIEW_WEBHOOK_SECRET=

# Web Push: public key is browser-visible; private key must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Use a real operator contact, e.g. mailto:operator@your-domain.example
VAPID_SUBJECT=

# Legacy anon key is also accepted when the publishable key is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_MODE=demo
# Set APP_MODE=production and your canonical HTTPS origin when deploying.
APP_ORIGIN=

# Optional signed read-only MT5 bridge. Keep disabled until migrations 009/010.
MT5_BRIDGE_ENABLED=false
MT5_BRIDGE_SECRET=

# Optional private Forex Factory toolkit API origin (server and worker only).
FF_SCRAPER_API_URL=
# Only for an authenticated reverse proxy; the upstream local API has no auth.
FF_SCRAPER_AUTH_TOKEN=
# Existing enabled calendar provider UUID, required for database/push ingestion.
FF_CALENDAR_PROVIDER_ID=
